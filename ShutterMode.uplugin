	"Version": 1,
	"VersionName": "1.0.0",
	"EngineVersion": "5.8.0",
	"FriendlyName": "ShutterMode - In-Game Photo Mode",
	"Description": "A finished player-facing photo mode. One call pauses the game, hides the HUD, detaches a leashed collision-aware free camera and hands the player field of view, real cinematic depth of field, data-driven colour filters, composition guides, letterbox and 1x/2x/4x high-resolution capture. Everything it touches - view target, pause, mouse cursor, input mode and HUD visibility - is recorded in a restore point and put back exactly as it was on exit.",
	"Category": "Camera",
	"CreatedBy": "Silvan Teufel",
	"CreatedByURL": "https://silvan.teufel-engineering.com",
	"DocsURL": "https://github.com/SimulatedFlow/ue-plugin-ShutterMode",
	"SupportURL": "mailto:teufelsilvan@gmail.com",
	"CanContainContent": true,
	"IsBetaVersion": false,
	"IsExperimentalVersion": false,
	"Installed": false,
